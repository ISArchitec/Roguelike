@startuml use_case_diagram_bureau
' ============================================================
' Диаграмма прецедентов — Рогалик «Бюро»
' ============================================================

title Диаграмма прецедентов — Рогалик «Бюро»

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #FEFECE
    BorderColor #A80036
    ArrowColor #A80036
}
skinparam actor {
    BackgroundColor #DDDDDD
    BorderColor #363636
}

' ------------------------------------------------------------
' Акторы
' ------------------------------------------------------------
actor "Игрок (management сценарии)" as Player
actor "Персонаж (gameplay сценарии)" as Character

' ------------------------------------------------------------
' Границы системы
' ------------------------------------------------------------

usecase UC1  as "Начать новую игру"
usecase UC2  as "Сохранить игру"
usecase UC3  as "Загрузить игру"
usecase UC4  as "Выйти из игры"

usecase UC5  as "Переместиться\nв клетку"
usecase UC6  as "Атаковать врага"
usecase UC7  as "Применить\nспец. атаку"
usecase UC8  as "Использовать\nпредмет рюкзака"
usecase UC9  as "Просмотреть\nинвентарь"
usecase UC10 as "Сменить\nудостоверение"
usecase UC14 as "Завершить\nуровень"


' ------------------------------------------------------------
' Связи акторов с прецедентами
' ------------------------------------------------------------

Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC4

Character --> UC5
Character --> UC6
Character --> UC7
Character --> UC8
Character --> UC9
Character --> UC10

Character --> UC14

' ------------------------------------------------------------
' Отношения include / extend
' ------------------------------------------------------------

' Перемещение может привести к атаке
UC6 ..> UC5  : <<extend>>


' Сохранение/загрузка/выход
UC4 ..> UC2  : <<include>>

@enduml