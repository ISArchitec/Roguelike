@startuml
skinparam shadowing false
skinparam sequenceParticipant roundCorner 0
skinparam sequenceLifeLineBorderColor black
skinparam sequenceLifeLineBackgroundColor white
skinparam sequenceMessageAlign center
title Игровой цикл

actor Игрок as Player
participant Console
participant Game
participant ILevelGenerator as Generator
participant GlobalConfig as Config
participant Hero
participant IEnemy as Enemy
participant Map

Player -> Console: run()
alt Новая игра
    Console -> Game: create_new(generator, event_queue, console)
    ref over Game, Config: Начальный набор предметов
    Game -> Hero: Hero(params, Position(0, 0), one_timers, event_queue)
    ref over Game, Generator: Генерация уровня
    Game -> Hero: set_map(map)
    Game -> Map: set_on_terminate_object(callback)
    Game -> Config: register_save(save_date)
else Загрузка
    ref over Console: Загрузка игры
end
Console -> Game: run_game()
loop Пока игра не остановлена
    alt Герой погиб
        Game -> Config: invalidate_save(save_date)
        Game -> Console: on_lost()
        break Завершение попытки
            Game --> Console: return
        end
    else Врагов нет и награда подобрана
        alt Конец пятой секции
            Game -> Console: on_total_won()
            break Полная победа
                Game --> Console: return
            end
        else Следующий уровень
            Game -> Console: on_won()
            ref over Game, Generator: Генерация уровня
            Game -> Hero: reset_id_card(); set_map(new_map)
            Game -> Map: set_on_terminate_object(callback)
            Game -> Game: заменить участников, enemy_count; thing_got = 1
        end
    else Врагов нет и награда ещё не размещена
        ref over Game, Hero: Размещение награды на карте
    end
    Game -> Hero: step()
    loop Пока остались успешные действия героя
        Hero -> Console: Queue.get() -> next_event()
        Console -> Player: запрос команды
        Player --> Console: команда
        opt save / q / EOF / SIGTERM
            ref over Console: Сохранение на границе тиков
        end
        Console --> Hero: IEvent
        Hero -> Hero: event.accept_hero(self)
    end
    loop Для каждого живого врага
        Game -> Enemy: step()
    end
    Game -> Game: ticks += 1
    Game -> Map: draw()
end
@enduml
